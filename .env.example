# Local development only. Production NEVER permits mock delivery.
INQUIRY_DELIVERY=mock
# Preferred live delivery: create a Formspree form and paste only its public ID.
# This overrides mock/Resend on the contact page. No Resend or Redis keys needed.
FORMSPREE_FORM_ID=
# Optional local test outcomes: success, failure, timeout
MOCK_OUTCOME=success

# Public domain selected in the project brief. No secrets in NEXT_PUBLIC variables.
SITE_URL=https://derekmartin.consulting
# Leave as preview until launch checks are complete. Vercel preview stays noindex.
SITE_ENV=preview

# For real delivery: INQUIRY_DELIVERY=resend, verified sender and owner-specified recipient.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=
# At least 32 random characters. Never commit an actual secret.
RECEIPT_SIGNING_SECRET=
# Required with real delivery. Shared durable rate limiting and idempotency.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
